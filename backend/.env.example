# Database Configuration
DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/<database_name>
SYNC_DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/<database_name>

# Application Configuration
APP_NAME=YottaFlex.ai Loyalty Points Management System
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Business Rules Defaults
POINTS_EARN_THRESHOLD_INR=100.0
DEFAULT_POINTS_EXPIRY_DAYS=365
RANDOM_SEED=20261022

# Security & RBAC Configuration
JWT_SECRET_KEY=your-secure-random-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
